{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "db/**/*.ts", "services/**/*.ts", "utils/**/*.ts", "renderer/src/**/*.ts", "renderer/src/**/*.tsx"]
}
